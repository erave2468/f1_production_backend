APP_NAME=F1 Data API
APP_ENV=production
API_VERSION=1.0.0

# Option A: RDS credentials directly (simple first deployment)
DB_HOST=database-1-instance-1.xxxxxxxxx.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=f1db
DB_USER=admin
DB_PASSWORD=CHANGE_ME

# Option B: recommended on EC2. Attach an IAM role with secretsmanager:GetSecretValue,
# set this ARN, and DB_PASSWORD can be omitted.
AWS_REGION=ap-northeast-2
AWS_DB_SECRET_ARN=

# Optional RDS certificate validation. Download global-bundle.pem and set the path.
RDS_CA_BUNDLE=/etc/pki/rds/global-bundle.pem

FASTF1_CACHE_DIR=/var/cache/f1-api/fastf1
COLLECT_SEASONS=2026
COLLECT_AFTER_START_MINUTES=240
COLLECTOR_LOOKBACK_DAYS=365

# Set actual frontend origins in production, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
